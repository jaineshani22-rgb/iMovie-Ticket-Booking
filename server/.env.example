MONGO_URI=mongodb://127.0.0.1:27017/imovies
# Generate a unique secret, e.g. node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=
PORT=5000
NODE_ENV=development

# Set these passwords before seeding; use unique values of at least 12 characters.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Set to true only when intentionally resetting a development database.
SEED_ALLOW_DESTRUCTIVE=false
